{
  "name": "simple-mcp-server",
  "version": "1.0.0",
  "description": "A simple MCP implementation",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:vectors": "node dist/tools/vectorGenerator.js",
    "build:code": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js stdio",
    "start:http": "node dist/index.js http",
    "start:sse": "node dist/index.js sse",
    "dev": "tsc --watch",
    "test": "vitest run --run",
    "test:search": "npm run build && node test_search.js",
    "test:semantic": "npm run build && node test_semantic_search.js",
    "test:unified-search": "npm run build && node test_unified_search.js",
    "bench": "npm run build && node dist/benchmarks/benchmark.js",
    "bench:semantic": "npm run build && BENCH_SUITE=semantic node dist/benchmarks/benchmark.js",
    "bench:parsing": "npm run build && BENCH_SUITE=parsing node dist/benchmarks/benchmark.js",
    "bench:providers": "npm run build && BENCH_SUITE=providers node dist/benchmarks/benchmark.js",
    "bench:memory": "npm run build && BENCH_SUITE=memory node dist/benchmarks/benchmark.js",
    "lint": "eslint 'src/**/*.ts'",
    "lint:code": "eslint 'src/**/*.ts' --ignore-pattern 'src/**/*.{test.ts,spec.ts}'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "lint:tests": "eslint 'src/**/*.{test.ts,spec.ts}'",
    "format": "prettier --write 'src/**/*.{ts,js,json,md,test.ts}'",
    "format:check": "prettier --check 'src/**/*.{ts,js,json,md,test.ts}'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.7",
    "@msgpack/msgpack": "^3.1.2",
    "@xenova/transformers": "^2.17.2",
    "commander": "^12.0.0",
    "express": "^5.1.0",
    "ollama": "^0.6.0",
    "ums-parser": "file:ums-parser",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@tsconfig/node-ts": "^23.6.1",
    "@tsconfig/node22": "^22.0.2",
    "@tsconfig/strictest": "^2.0.5",
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/eslint-plugin": "^1.3.4",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
